# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Salin file ini menjadi .env lalu isi nilai aslinya secara lokal/di server.
# JANGAN PERNAH MENG-COMMIT FILE .env YANG BERISI KUNCI ASLI KE GIT!
# ==============================================================================

# Supabase Credentials (Dapatkan dari Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Flask Server Configuration
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000

# Celery & Redis Configuration (Opsional - Default ke local memory jika kosong)
# Untuk cloud Redis (misal Upstash): rediss://default:<password>@<host>:6379?ssl_cert_reqs=none
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_ALWAYS_EAGER=True
